<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta
            name="description"
            content="Rekindled Hub status dashboard for Rekindled Server. View registered servers and service information."
        />
        <meta property="og:title" content="Rekindled Hub" />
        <meta
            property="og:description"
            content="Rekindled Hub service status and registered game servers."
        />
        <meta property="og:type" content="website" />
        <title>Rekindled Hub</title>
        <style>
            :root {
                color-scheme: dark;
                --bg: #101419;
                --surface: #191f27;
                --surface-alt: #202833;
                --text: #e6eaf0;
                --muted: #a4afbd;
                --accent: #90b9e8;
                --border: #343e4a;
                --error: #ffb4ac;
            }
            .light {
                color-scheme: light;
                --bg: #f3f5f7;
                --surface: #fff;
                --surface-alt: #edf1f5;
                --text: #202b38;
                --muted: #536273;
                --accent: #235e99;
                --border: #ced6df;
                --error: #a52b22;
            }
            * {
                box-sizing: border-box;
            }
            body {
                margin: 0;
                background: var(--bg);
                color: var(--text);
                font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
                line-height: 1.6;
            }
            a {
                color: var(--accent);
                text-underline-offset: 3px;
            }
            :focus-visible {
                outline: 2px solid var(--accent);
                outline-offset: 4px;
            }
            [hidden] {
                display: none !important;
            }
            .skip-link {
                position: absolute;
                top: -80px;
                left: 20px;
                padding: 10px;
                background: var(--surface);
            }
            .skip-link:focus {
                top: 12px;
            }
            body > header, .page, footer {
                max-width: 1160px;
                margin: auto;
                padding: 24px;
            }
            body > header {
                padding-top: 48px;
                padding-right: 160px;
            }
            h1 {
                margin: 0;
                font-size: clamp(1.8rem, 4vw, 2.4rem);
                letter-spacing: -0.035em;
                font-weight: 650;
            }
            .subtitle {
                margin: 8px 0 0;
                color: var(--muted);
                max-width: 680px;
            }
            .top-panel {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 16px;
            }
            .panel {
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: 10px;
                padding: 22px;
                min-width: 0;
            }
            .panel h2 {
                margin: 0;
                font-size: .9rem;
                font-weight: 500;
                color: var(--muted);
            }
            .metric {
                margin: 8px 0;
                font-size: clamp(1.5rem, 3vw, 2.2rem);
                font-weight: 600;
                font-variant-numeric: tabular-nums;
                overflow-wrap: anywhere;
            }
            small {
                color: var(--muted);
            }
            .meta {
                margin: 20px 0;
                font-size: .875rem;
                color: var(--muted);
            }
            .status-line.error {
                color: var(--error);
            }
            .configuration {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
                gap: 12px;
            }
            details {
                border: 1px solid var(--border);
                border-radius: 8px;
                background: var(--surface);
                min-width: 0;
                align-self: start;
            }
            summary {
                padding: 12px 16px;
                cursor: pointer;
                font-size: .9rem;
            }
            .count {
                color: var(--muted);
                margin-left: 8px;
            }
            .config-list {
                max-height: 200px;
                overflow-y: auto;
                overscroll-behavior: contain;
                margin: 0;
                padding: 0 16px 12px 34px;
                font-size: .875rem;
            }
            .config-list li {
                padding: 6px 0;
                overflow-wrap: anywhere;
            }
            .theme-toggle {
                position: absolute;
                top: 48px;
                right: max(24px, calc((100vw - 1112px) / 2));
                padding: 8px 12px;
                border: 1px solid var(--border);
                border-radius: 6px;
                background: var(--surface);
                color: var(--text);
                font: inherit;
                font-size: .85rem;
                cursor: pointer;
            }
            .theme-toggle:hover, summary:hover {
                background: var(--surface-alt);
            }
            .server-list {
                margin-top: 28px;
                border: 1px solid var(--border);
                border-radius: 10px;
                overflow: hidden;
                background: var(--surface);
            }
            .server-list header {
                padding: 16px 20px;
                border-bottom: 1px solid var(--border);
                display: flex;
                justify-content: space-between;
                gap: 16px;
                align-items: center;
            }
            .server-list h2 {
                margin: 0;
                font-size: 1rem;
                font-weight: 600;
            }
            .api-link {
                font-size: .8rem;
            }
            .table-scroll {
                overflow-x: auto;
            }
            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 620px;
            }
            th {
                text-align: left;
                font-size: .8rem;
                font-weight: 500;
                color: var(--muted);
                background: var(--surface-alt);
            }
            th, td {
                padding: 12px 20px;
                border-bottom: 1px solid var(--border);
            }
            td {
                font-size: .875rem;
                vertical-align: top;
                overflow-wrap: anywhere;
                max-width: 360px;
            }
            tbody tr:last-child td {
                border-bottom: 0;
            }
            tbody tr:hover {
                background: var(--surface-alt);
            }
            .status-pill {
                display: inline-block;
                border: 1px solid var(--border);
                border-radius: 4px;
                padding: 1px 7px;
                font-size: .75rem;
                white-space: nowrap;
                color: var(--muted);
            }
            .status-pill.shard {
                color: var(--accent);
            }
            .empty-state {
                padding: 36px 20px;
                text-align: center;
                color: var(--muted);
            }
            footer {
                color: var(--muted);
                font-size: .8rem;
                padding-bottom: 32px;
            }
            @media (max-width: 640px) {
                body > header {
                    padding-top: 80px;
                    padding-right: 24px;
                }
                .theme-toggle {
                    top: 20px;
                }
                .top-panel {
                    grid-template-columns: 1fr;
                    gap: 12px;
                }
                .panel {
                    padding: 16px 20px;
                }
                .page {
                    padding-top: 0;
                }
            }
        </style>
    </head>
    <body>
        <a href="#dashboard" class="skip-link">Skip to dashboard</a>
        <button
            id="themeToggle"
            class="theme-toggle"
            type="button"
            aria-label="Toggle light/dark theme"
        >
            <span id="themeToggleIcon" aria-hidden="true">Light theme</span>
        </button>

        <header>
            <h1>Rekindled Hub</h1>
            <p class="subtitle">
                Registered game servers, hub uptime, and supported client versions.
                Data refreshes automatically while this page is open.
            </p>
        </header>

        <main id="dashboard" class="page">
            <section class="top-panel" aria-label="Hub metrics">
                <article class="panel">
                    <h2>Active servers</h2>
                    <p class="metric" id="activeCount">
                        <%= status.activeServerCount %>
                    </p>
                    <small id="refreshInfo"></small>
                </article>
                <article class="panel">
                    <h2>Hub uptime</h2>
                    <p class="metric" id="uptime"><%= uptime %></p>
                    <small>Process uptime since service start</small>
                </article>
                <article
                    class="panel"
                    aria-labelledby="oldestVersionLabel"
                    aria-describedby="oldestVersionDesc"
                >
                    <h2 id="oldestVersionLabel">Minimum client version</h2>
                    <p class="metric" id="oldestVersionValue">
                        <%= status.oldestSupportedVersion %>
                    </p>
                    <small id="oldestVersionDesc"
                        >Minimum client version accepted</small
                    >
                </article>
            </section>

            <section
                class="meta"
                id="statusMeta"
                aria-live="polite"
                aria-atomic="true"
            >
                <span class="status-line" id="pollStatus">Status: waiting for update</span>
            </section>
            <section class="configuration" aria-label="Server configuration">
                <% const lists = [
                    ...(Array.isArray(status.shardingAllowList) ? [["allowedShard", "Sharding allowlist", status.shardingAllowList]] : []),
                    ["filters", "Filters", status.filters],
                    ["censors", "Censors", status.censors]
                ]; %>
                <% lists.forEach(([id, label, values]) => { const entries = Array.isArray(values) ? values : []; %>
                <details>
                    <summary><%= label %><span class="count" id="<%= id %>Count">(<%= entries.length %>)</span></summary>
                    <ul class="config-list" id="<%= id %>List" tabindex="0" aria-label="<%= label %>">
                        <% if (!entries.length) { %><li>No entries configured.</li><% } %>
                        <% entries.forEach(value => { %><li><%= value %></li><% }); %>
                    </ul>
                </details>
                <% }); %>
            </section>

            <section class="server-list" aria-label="Active server list">
                <header><h2>Active servers</h2><a class="api-link" href="/api/v1/servers" target="_blank" rel="noopener noreferrer">View JSON</a></header>
                <div id="serverLoading" class="empty-state">
                    Loading server list…
                </div>
                <div class="table-scroll" tabindex="0" role="region" aria-label="Active servers">
                <table
                    id="serversTable"
                    hidden
                    aria-label="Server table overview"
                >
                    <thead>
                        <tr>
                            <th>Host</th>
                            <th>Description</th>
                            <th>Players</th>
                            <th>Mode</th>
                            <th>Shard</th>
                        </tr>
                    </thead>
                    <tbody id="serversBody"></tbody>
                </table>
                </div>
                <div id="serversEmpty" class="empty-state" hidden>
                    No servers are currently registered with the hub.
                </div>
            </section>
        </main>

        <footer>Rekindled Hub &middot; Server directory and service status</footer>
        <script id="dashboard-config" type="application/json"><%- JSON.stringify({ pollIntervalMs }) %></script>
        <script>
            const THEME_KEY = "rekindled-hub:theme";
            const themeButton = document.getElementById("themeToggle");
            const themeIcon = document.getElementById("themeToggleIcon");
            const getTheme = () => {
                try { return localStorage.getItem(THEME_KEY) || "dark"; }
                catch { return document.documentElement.classList.contains("light") ? "light" : "dark"; }
            };

            const setTheme = (theme) => {
                document.documentElement.classList.toggle(
                    "light",
                    theme === "light",
                );
                themeIcon.textContent = theme === "light" ? "Dark theme" : "Light theme";
                themeButton.setAttribute(
                    "aria-label",
                    theme === "light"
                        ? "Switch to dark theme"
                        : "Switch to light theme",
                );
                try { localStorage.setItem(THEME_KEY, theme); } catch {}
            };

            themeButton.addEventListener("click", () =>
                setTheme(getTheme() === "light" ? "dark" : "light"),
            );
            setTheme(getTheme());

            const POLL_INTERVAL_MS = (() => {
                const raw =
                    document.getElementById("dashboard-config")?.textContent;
                if (!raw) return 15000;
                try {
                    return JSON.parse(raw).pollIntervalMs || 15000;
                } catch {
                    return 15000;
                }
            })();

            const setText = (id, value) => {
                const el = document.getElementById(id);
                if (el) el.textContent = value;
            };

            const setStatus = (message, type = "normal") => {
                const status = document.getElementById("pollStatus");
                if (!status) return;
                status.textContent = `Status: ${message}`;
                status.className =
                    type === "error" ? "status-line error" : "status-line";
            };

            const updateServerInfo = (meta) => {
                [["allowedShard", meta?.shardingAllowList], ["filters", meta?.filters], ["censors", meta?.censors]].forEach(([id, values]) => {
                    const list = document.getElementById(`${id}List`);
                    if (!list) return;
                    const entries = Array.isArray(values) ? values : [];
                    setText(`${id}Count`, `(${entries.length})`);
                    list.replaceChildren(...(entries.length ? entries : ["No entries configured."]).map(value => {
                        const item = document.createElement("li");
                        item.textContent = String(value);
                        return item;
                    }));
                });
            };

            const safeString = (value, fallback = "") =>
                value != null && value !== "" ? String(value) : fallback;

            const renderRows = (servers) => {
                const table = document.getElementById("serversTable");
                const body = document.getElementById("serversBody");
                const empty = document.getElementById("serversEmpty");
                const loader = document.getElementById("serverLoading");

                if (!body || !table || !empty || !loader) return;
                body.innerHTML = "";

                if (!Array.isArray(servers)) {
                    table.hidden = true;
                    empty.hidden = true;
                    loader.hidden = false;
                    loader.textContent = "Server data unavailable";
                    return;
                }

                if (servers.length === 0) {
                    table.hidden = true;
                    empty.hidden = false;
                    loader.hidden = true;
                    return;
                }

                table.hidden = false;
                empty.hidden = true;
                loader.hidden = true;

                servers.forEach((s) => {
                    const row = document.createElement("tr");

                    const hostCell = document.createElement("td");
                    const hostname = safeString(s.Hostname, "Unknown");
                    hostCell.title = hostname;

                    if (s.WebAddress && typeof s.WebAddress === "string") {
                        try {
                            const candidate = new URL(s.WebAddress);
                            if (
                                candidate.protocol === "http:" ||
                                candidate.protocol === "https:"
                            ) {
                                const link = document.createElement("a");
                                link.href = candidate.toString();
                                link.target = "_blank";
                                link.rel = "noopener noreferrer";
                                link.style.color = "var(--accent)";
                                link.textContent = hostname;
                                hostCell.appendChild(link);
                            } else {
                                hostCell.textContent = hostname;
                            }
                        } catch {
                            hostCell.textContent = hostname;
                        }
                    } else {
                        hostCell.textContent = hostname;
                    }

                    const descCell = document.createElement("td");
                    const description = safeString(
                        s.Description,
                        "No description",
                    );
                    descCell.title = description;
                    descCell.textContent = description;

                    const playerCell = document.createElement("td");
                    playerCell.textContent = String(
                        Number.isInteger(s.PlayerCount)
                            ? s.PlayerCount
                            : Number(s.PlayerCount) || 0,
                    );

                    const modeCell = document.createElement("td");
                    modeCell.textContent = safeString(s.GameType, "Classic");

                    const shardCell = document.createElement("td");
                    const shardSpan = document.createElement("span");
                    shardSpan.className = `status-pill ${s.IsShard ? "shard" : ""}`;
                    shardSpan.textContent = s.IsShard ? "shard" : "main";
                    shardCell.appendChild(shardSpan);

                    row.appendChild(hostCell);
                    row.appendChild(descCell);
                    row.appendChild(playerCell);
                    row.appendChild(modeCell);
                    row.appendChild(shardCell);
                    body.appendChild(row);
                });
            };

            const fetchStatus = async () => {
                try {
                    const res = await fetch("/api/v1/servers/status", {
                        cache: "no-store",
                    });
                    if (!res.ok) throw new Error("status fetch failed");
                    const json = await res.json();
                    if (json.status !== "success")
                        throw new Error("status payload invalid");

                    setText("activeCount", json.statusData.activeServerCount);
                    setText("uptime", json.statusData.uptime);
                    updateServerInfo(json.statusData);
                    setText("oldestVersionValue", json.statusData.oldestSupportedVersion);
                    return true;
                } catch (error) {
                    console.warn("Status update error", error);
                    return false;
                }
            };

            const fetchServers = async () => {
                const loader = document.getElementById("serverLoading");
                try {
                    const res = await fetch("/api/v1/servers", {
                        cache: "no-store",
                    });
                    if (!res.ok) throw new Error("server fetch failed");
                    const json = await res.json();
                    if (json.status !== "success" || !Array.isArray(json.servers))
                        throw new Error("server payload invalid");

                    renderRows(json.servers);
                    return true;
                } catch (error) {
                    console.warn("Server list error", error);
                    if (!loader.hidden) loader.textContent = "Server list unavailable. Retrying automatically.";
                    return false;
                }
            };

            let refreshing = false;
            setText("refreshInfo", `Refreshes every ${POLL_INTERVAL_MS / 1000} seconds`);
            const refresh = async () => {
                if (refreshing) return;
                refreshing = true;
                try {
                    const results = await Promise.all([fetchStatus(), fetchServers()]);
                    if (results.every(Boolean)) {
                        setStatus(`Updated at ${new Date().toLocaleTimeString()}`);
                    } else {
                        setStatus("Refresh incomplete. Displayed data may be outdated. Retrying automatically.", "error");
                    }
                } finally {
                    refreshing = false;
                }
            };

            refresh();
            let refreshInterval = setInterval(refresh, POLL_INTERVAL_MS);

            document.addEventListener("visibilitychange", () => {
                if (document.hidden) {
                    clearInterval(refreshInterval);
                } else {
                    refresh();
                    refreshInterval = setInterval(refresh, POLL_INTERVAL_MS);
                }
            });
        </script>
    </body>
</html>
